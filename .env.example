# Backend settings. Copy to .env and fill in. NEVER commit .env.

# Hugging Face access token (Settings -> Access Tokens). Optional but raises try-on quota.
HF_TOKEN=

# Hugging Face model repo holding the classifier, e.g. yourname/wearwisely-model
MODEL_REPO=
MODEL_FILENAME=final_body_model.keras

# Dev shortcut: use a local file instead of downloading from the Hub
# LOCAL_MODEL_PATH=dl/saved_model/final_body_model.keras

# Comma-separated frontend URLs allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# UPLOAD_FOLDER=temp
